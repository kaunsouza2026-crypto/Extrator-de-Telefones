<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Extrator de Telefones | Fichas &amp; GOV</title>
    <style>
        /* Variáveis de Tema (Claro e Escuro) - Zero dependências externas */
        :root {
            --bg-body: #f8fafc;
            --bg-card: #ffffff;
            --bg-input: #f1f5f9;
            --bg-header: rgba(255, 255, 255, 0.88);
            --border-color: #e2e8f0;
            --border-input: #cbd5e1;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --accent: #059669;
            --accent-hover: #047857;
            --accent-soft: #d1fae5;
            --accent-text: #065f46;
            --danger-bg: #ffe4e6;
            --danger-text: #e11d48;
            --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06);
        }

        html.dark {
            --bg-body: #020617;
            --bg-card: #0f172a;
            --bg-input: #070d1f;
            --bg-header: rgba(15, 23, 42, 0.88);
            --border-color: #1e293b;
            --border-input: #334155;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent: #10b981;
            --accent-hover: #059669;
            --accent-soft: rgba(16, 185, 129, 0.14);
            --accent-text: #34d399;
            --danger-bg: rgba(225, 29, 72, 0.15);
            --danger-text: #fb7185;
            --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.35);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: background-color 0.2s ease, color 0.2s ease;
            line-height: 1.5;
        }

        /* Cabeçalho */
        header {
            position: sticky;
            top: 0;
            z-index: 20;
            background: var(--bg-header);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-color);
        }

        .header-inner {
            max-width: 1180px;
            margin: 0 auto;
            padding: 0.9rem 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: var(--accent);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 6px 16px rgba(16, 185, 129, 0.25);
            flex-shrink: 0;
        }

        .brand h1 {
            font-size: 1.125rem;
            font-weight: 700;
            letter-spacing: -0.01em;
        }

        .brand p {
            font-size: 0.78rem;
            color: var(--text-muted);
        }

        .btn-icon {
            padding: 0.6rem;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            background: var(--bg-input);
            color: var(--text-main);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.15s ease;
        }

        .btn-icon:hover {
            border-color: var(--accent);
        }

        html.dark .icon-moon { display: none; }
        html:not(.dark) .icon-sun { display: none; }

        /* Container Principal */
        main {
            flex: 1;
            max-width: 1180px;
            width: 100%;
            margin: 0 auto;
            padding: 1.5rem 1.25rem 2.5rem;
        }

        /* Painel de Configurações */
        .controls-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 1.15rem 1.25rem;
            margin-bottom: 1.25rem;
            box-shadow: var(--shadow-sm);
            display: grid;
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        @media (min-width: 860px) {
            .controls-card {
                grid-template-columns: 330px 1fr;
                align-items: center;
                gap: 1.5rem;
            }
        }

        .field-label {
            display: block;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-bottom: 0.4rem;
        }

        select {
            width: 100%;
            padding: 0.65rem 0.85rem;
            border-radius: 12px;
            border: 1px solid var(--border-input);
            background: var(--bg-input);
            color: var(--text-main);
            font-size: 0.88rem;
            font-weight: 500;
            outline: none;
            cursor: pointer;
            transition: border-color 0.15s ease;
        }

        select:focus {
            border-color: var(--accent);
        }

        .checkbox-group {
            display: flex;
            flex-wrap: wrap;
            gap: 0.9rem 1.4rem;
            align-items: center;
        }

        @media (min-width: 860px) {
            .checkbox-group {
                padding-top: 1.15rem;
            }
        }

        .checkbox-label {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.88rem;
            font-weight: 500;
            cursor: pointer;
            user-select: none;
        }

        .checkbox-label input[type="checkbox"] {
            width: 17px;
            height: 17px;
            accent-color: var(--accent);
            cursor: pointer;
            border-radius: 4px;
        }

        .code-pill {
            padding: 0.1rem 0.4rem;
            border-radius: 6px;
            background: var(--accent-soft);
            color: var(--accent-text);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.78rem;
            font-weight: 600;
        }

        /* Grid Entrada / Saída */
        .workspace-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.25rem;
        }

        @media (min-width: 960px) {
            .workspace-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        .panel {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 1.15rem 1.25rem;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
        }

        .panel-header {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 0.6rem;
            margin-bottom: 0.85rem;
        }

        .panel-title {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.96rem;
            font-weight: 600;
        }

        .dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            display: inline-block;
        }

        .dot-blue { background: #3b82f6; }
        .dot-green { background: var(--accent); }

        .badge {
            padding: 0.15rem 0.6rem;
            border-radius: 999px;
            font-size: 0.76rem;
            font-weight: 700;
            background: var(--accent-soft);
            color: var(--accent-text);
        }

        .actions {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.48rem 0.85rem;
            border-radius: 10px;
            font-size: 0.78rem;
            font-weight: 600;
            border: 1px solid transparent;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .btn-secondary {
            background: var(--bg-input);
            border-color: var(--border-color);
            color: var(--text-main);
        }

        .btn-secondary:hover:not(:disabled) {
            border-color: var(--accent);
        }

        .btn-danger {
            background: var(--danger-bg);
            color: var(--danger-text);
        }

        .btn-danger:hover:not(:disabled) {
            filter: brightness(0.95);
        }

        .btn-primary {
            background: var(--accent);
            color: #ffffff;
            box-shadow: 0 2px 8px rgba(16, 185, 129, 0.25);
        }

        .btn-primary:hover:not(:disabled) {
            background: var(--accent-hover);
        }

        textarea {
            width: 100%;
            min-height: 310px;
            flex: 1;
            border-radius: 12px;
            border: 1px solid var(--border-input);
            background: var(--bg-input);
            color: var(--text-main);
            padding: 0.9rem;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.83rem;
            line-height: 1.6;
            resize: vertical;
            outline: none;
            transition: border-color 0.15s ease;
        }

        textarea:focus {
            border-color: var(--accent);
        }

        textarea[readonly] {
            color: var(--accent-text);
            font-size: 0.9rem;
            font-weight: 600;
        }

        .panel-footer {
            margin-top: 0.75rem;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem;
            font-size: 0.76rem;
            color: var(--text-muted);
        }

        /* Toast Flutuante */
        .toast {
            position: fixed;
            bottom: 1.25rem;
            right: 1.25rem;
            z-index: 50;
            background: #0f172a;
            color: #ffffff;
            border: 1px solid #334155;
            padding: 0.75rem 1.1rem;
            border-radius: 12px;
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
            display: flex;
            align-items: center;
            gap: 0.55rem;
            font-size: 0.85rem;
            font-weight: 500;
            transform: translateY(120%);
            opacity: 0;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            pointer-events: none;
        }

        html.dark .toast {
            background: var(--accent);
            border-color: transparent;
        }

        .toast.show {
            transform: translateY(0);
            opacity: 1;
        }
    </style>
</head>
<body>

    <!-- Cabeçalho -->
    <header>
        <div class="header-inner">
            <div class="brand">
                <div class="brand-icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                </div>
                <div>
                    <h1>Extrator de Telefones</h1>
                    <p>Compatível com Fichas Padrão (|) e Fichas GOV</p>
                </div>
            </div>

            <button id="themeToggle" type="button" class="btn-icon" aria-label="Alternar tema claro ou escuro" title="Alternar tema">
                <svg class="icon-sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
                </svg>
                <svg class="icon-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
                </svg>
            </button>
        </div>
    </header>

    <!-- Conteúdo Principal -->
    <main>
        <!-- Barra de Configurações -->
        <section class="controls-card" aria-label="Configurações de extração">
            <div>
                <label for="extractionMode" class="field-label">Modo de Extração</label>
                <select id="extractionMode">
                    <option value="auto" selected>Automático (Ambos os formatos)</option>
                    <option value="gov">Rótulo Telefone GOV / Telefone:</option>
                    <option value="col7">7ª Coluna (separada por |)</option>
                    <option value="general">Busca Geral de Celulares</option>
                </select>
            </div>

            <div class="checkbox-group">
                <label class="checkbox-label">
                    <input type="checkbox" id="removeDuplicates" checked>
                    <span>Remover números repetidos</span>
                </label>

                <label class="checkbox-label">
                    <input type="checkbox" id="addCountryCode">
                    <span>Adicionar DDI <span class="code-pill">55</span> na frente</span>
                </label>

                <label class="checkbox-label">
                    <input type="checkbox" id="onlyMobile">
                    <span>Só celular (9º dígito)</span>
                </label>
            </div>
        </section>

        <!-- Área de Trabalho -->
        <div class="workspace-grid">
            <!-- Painel de Entrada -->
            <section class="panel">
                <div class="panel-header">
                    <div class="panel-title">
                        <span class="dot dot-blue"></span>
                        <span>1. Cole suas fichas aqui</span>
                    </div>
                    <div class="actions">
                        <button id="btnExample" type="button" class="btn btn-secondary">Colar Exemplo</button>
                        <button id="btnClear" type="button" class="btn btn-danger">Limpar</button>
                    </div>
                </div>

                <textarea
                    id="inputText"
                    placeholder="Cole uma ou várias fichas aqui (pode misturar os dois modelos):&#10;&#10;Modelo 1:&#10;1978|3669-2|21276278000166|VANESSA CALISTO GREIJO|29186399829|VANESSA CALISTO GREIJO|13996186760|VCG00368&#10;&#10;Modelo 2 (GOV):&#10;[0055|77170-8] - [06039460000100] - [EMPRESA LTDA] - CPF: | Nome: MARCOS | Telefone GOV: 13996367551 | Telefone GOV final: ****51"
                ></textarea>

                <div class="panel-footer">
                    <span id="lineCount">0 fichas processadas</span>
                    <span>Extração instantânea</span>
                </div>
            </section>

            <!-- Painel de Saída -->
            <section class="panel">
                <div class="panel-header">
                    <div class="panel-title">
                        <span class="dot dot-green"></span>
                        <span>2. Telefones Extraídos</span>
                        <span id="phoneBadge" class="badge">0</span>
                    </div>
                    <div class="actions">
                        <button id="btnDownload" type="button" class="btn btn-secondary" disabled>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>
                            </svg>
                            Baixar .txt
                        </button>
                        <button id="btnCopy" type="button" class="btn btn-primary" disabled>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                            </svg>
                            <span id="copyBtnText">Copiar Tudo</span>
                        </button>
                    </div>
                </div>

                <textarea
                    id="outputText"
                    readonly
                    placeholder="Os telefones limpos aparecerão aqui, um por linha..."
                ></textarea>

                <div class="panel-footer">
                    <span id="statusMessage">Aguardando fichas...</span>
                    <span id="filterSummary"></span>
                </div>
            </section>
        </div>
    </main>

    <!-- Toast de Feedback -->
    <div id="toast" class="toast" role="status" aria-live="polite">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span id="toastText">Copiado!</span>
    </div>

    <script>
        (function () {
            const inputText = document.getElementById('inputText');
            const outputText = document.getElementById('outputText');
            const extractionMode = document.getElementById('extractionMode');
            const removeDuplicates = document.getElementById('removeDuplicates');
            const addCountryCode = document.getElementById('addCountryCode');
            const onlyMobile = document.getElementById('onlyMobile');

            const btnExample = document.getElementById('btnExample');
            const btnClear = document.getElementById('btnClear');
            const btnCopy = document.getElementById('btnCopy');
            const copyBtnText = document.getElementById('copyBtnText');
            const btnDownload = document.getElementById('btnDownload');

            const lineCount = document.getElementById('lineCount');
            const phoneBadge = document.getElementById('phoneBadge');
            const statusMessage = document.getElementById('statusMessage');
            const filterSummary = document.getElementById('filterSummary');
            const themeToggle = document.getElementById('themeToggle');

            // Exemplo misturando o formato antigo (|) e o formato novo (GOV)
            const SAMPLE_DATA = [
                "1978|3669-2|21276278000166|VANESSA CALISTO GREIJO|29186399829|VANESSA CALISTO GREIJO|13996186760|VCG00368",
                "[0055|77170-8] - [06039460000100] - [KALIU RESTAURACAO E SERVICOS DE FIBERGLASS E COMERCIO LTDA] - CPF:   | Nome: MARCOS AZEVEDO | Data de nascimento: 01/06/1966 | Usuário: MAZ00925 | Telefone GOV: 13996367551 | Telefone GOV final: ****51 | E-mail GOV: ar****@gm***",
                "1980|3671-9|98541236000155|MARIA FERNANDA COSTA|41258963214|MARIA FERNANDA COSTA|(11) 98765-4321|MFC00370",
                "[0056|88210-4] - [12345678000199] - [ALPHA SERVICOS LTDA] - CPF: 12345678900 | Nome: JOAO SILVA | Data de nascimento: 15/03/1980 | Usuário: JSI00120 | Telefone GOV: (21) 99123-4567 | Telefone GOV final: ****67 | E-mail GOV: jo****@gm***"
            ].join('\n');

            function onlyDigits(str) {
                return (str || '').replace(/\D/g, '');
            }

            /**
             * Extrai especificamente o número após "Telefone GOV:" ou "Telefone:"
             * Ignora "Telefone GOV final: ****51", datas, CPF e CNPJ.
             */
            function extractByGovLabel(line) {
                // Casa "Telefone GOV:" ou "Telefone:" (não seguido de "final"), pegando até o próximo "|" ou fim
                const regex = /Telefone(?:\s+GOV)?(?!\s+final)\s*:\s*([^|\r\n]+)/i;
                const match = line.match(regex);
                if (match && match[1]) {
                    return onlyDigits(match[1]);
                }
                return '';
            }

            /**
             * Extrai da 7ª coluna (índice 6) no formato separado por '|'
             */
            function extractByCol7(line) {
                const cols = line.split('|');
                if (cols.length >= 7) {
                    return onlyDigits(cols[6]);
                }
                return '';
            }

            /**
             * Busca geral de celulares brasileiros (DDD + 9 + 8 dígitos) na linha,
             * removendo datas e evitando pegar CPF/CNPJ.
             */
            function extractGeneralMobile(line) {
                // Remove datas no formato dd/mm/aaaa para não confundir dígitos
                const cleanLine = line.replace(/\b\d{2}\/\d{2}\/\d{4}\b/g, ' ');
                // Busca padrões de celular com 11 dígitos (DDD 2 dígitos + 9 + 8 dígitos) com ou sem máscara
                const mobileRegex = /(?:\+?55\s*)?\(?([1-9]{2})\)?[\s.-]*(9\d{4})[\s.-]*(\d{4})\b/g;
                let match;
                const found = [];
                while ((match = mobileRegex.exec(cleanLine)) !== null) {
                    found.push(match[1] + match[2] + match[3]);
                }
                return found.length > 0 ? found[found.length - 1] : '';
            }

            /**
             * Processa todas as linhas coladas conforme o modo escolhido
             */
            function processExtraction() {
                const raw = inputText.value;
                const lines = raw.split(/\r?\n/).filter(l => l.trim() !== '');

                lineCount.textContent = `${lines.length} ${lines.length === 1 ? 'ficha processada' : 'fichas processadas'}`;

                if (lines.length === 0) {
                    outputText.value = '';
                    phoneBadge.textContent = '0';
                    statusMessage.textContent = 'Aguardando fichas...';
                    filterSummary.textContent = '';
                    btnCopy.disabled = true;
                    btnDownload.disabled = true;
                    return;
                }

                const mode = extractionMode.value;
                const dedupe = removeDuplicates.checked;
                const add55 = addCountryCode.checked;
                const mobileOnly = onlyMobile.checked;

                let extracted = [];
                let skippedLandlines = 0;

                lines.forEach(line => {
                    let phone = '';

                    if (mode === 'auto') {
                        // 1. Se tiver rótulo Telefone GOV: ou Telefone:, extrai direto dele
                        if (/Telefone(?:\s+GOV)?(?!\s+final)\s*:/i.test(line)) {
                            phone = extractByGovLabel(line);
                        } else if (line.includes('|')) {
                            // 2. Caso contrário, se for separado por '|', pega a 7ª coluna (índice 6)
                            phone = extractByCol7(line);
                        }
                    } else if (mode === 'gov') {
                        phone = extractByGovLabel(line);
                    } else if (mode === 'col7') {
                        phone = extractByCol7(line);
                    } else if (mode === 'general') {
                        phone = extractGeneralMobile(line);
                    }

                    // Normaliza caso já venha com 55 na frente (12 ou 13 dígitos)
                    if ((phone.length === 12 || phone.length === 13) && phone.startsWith('55')) {
                        phone = phone.slice(2);
                    }

                    if (phone.length >= 10 && phone.length <= 11) {
                        // Filtro opcional: apenas celulares (11 dígitos com 9 na 3ª posição)
                        const isMobile = phone.length === 11 && phone[2] === '9';
                        if (mobileOnly && !isMobile) {
                            skippedLandlines++;
                            return;
                        }

                        if (add55) {
                            phone = '55' + phone;
                        }
                        extracted.push(phone);
                    }
                });

                const beforeDedupe = extracted.length;
                let removedDuplicatesCount = 0;

                if (dedupe) {
                    const unique = new Set(extracted);
                    removedDuplicatesCount = beforeDedupe - unique.size;
                    extracted = Array.from(unique);
                }

                outputText.value = extracted.join('\n');
                phoneBadge.textContent = extracted.length;

                const hasData = extracted.length > 0;
                btnCopy.disabled = !hasData;
                btnDownload.disabled = !hasData;

                statusMessage.textContent = hasData
                    ? `${extracted.length} ${extracted.length === 1 ? 'telefone extraído' : 'telefones extraídos'}`
                    : 'Nenhum telefone encontrado neste formato';

                const notes = [];
                if (removedDuplicatesCount > 0) {
                    notes.push(`${removedDuplicatesCount} repetido${removedDuplicatesCount > 1 ? 's' : ''} removido${removedDuplicatesCount > 1 ? 's' : ''}`);
                }
                if (skippedLandlines > 0) {
                    notes.push(`${skippedLandlines} fixo${skippedLandlines > 1 ? 's' : ''} ignorado${skippedLandlines > 1 ? 's' : ''}`);
                }
                filterSummary.textContent = notes.join(' • ');
            }

            let toastTimer;
            function showToast(msg) {
                const toast = document.getElementById('toast');
                const toastText = document.getElementById('toastText');
                toastText.textContent = msg;
                toast.classList.add('show');
                clearTimeout(toastTimer);
                toastTimer = setTimeout(() => {
                    toast.classList.remove('show');
                }, 2400);
            }

            // Listeners em tempo real
            inputText.addEventListener('input', processExtraction);
            extractionMode.addEventListener('change', processExtraction);
            removeDuplicates.addEventListener('change', processExtraction);
            addCountryCode.addEventListener('change', processExtraction);
            onlyMobile.addEventListener('change', processExtraction);

            // Colar Exemplo
            btnExample.addEventListener('click', () => {
                inputText.value = SAMPLE_DATA;
                processExtraction();
                showToast('Exemplos dos dois modelos carregados!');
            });

            // Limpar
            btnClear.addEventListener('click', () => {
                inputText.value = '';
                processExtraction();
                inputText.focus();
            });

            // Copiar Tudo
            btnCopy.addEventListener('click', () => {
                if (!outputText.value) return;
                outputText.select();
                outputText.setSelectionRange(0, 99999);
                try {
                    document.execCommand('copy');
                    copyBtnText.textContent = 'Copiado!';
                    showToast(`${phoneBadge.textContent} telefone(s) copiado(s)!`);
                    setTimeout(() => {
                        copyBtnText.textContent = 'Copiar Tudo';
                    }, 2000);
                } catch (e) {
                    showToast('Selecione os números e pressione Ctrl+C.');
                }
                window.getSelection().removeAllRanges();
            });

            // Baixar .txt
            btnDownload.addEventListener('click', () => {
                if (!outputText.value) return;
                const blob = new Blob([outputText.value], { type: 'text/plain;charset=utf-8' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                const today = new Date().toISOString().slice(0, 10);
                a.href = url;
                a.download = `telefones-${today}.txt`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                showToast('Arquivo .txt baixado!');
            });

            // Alternar Tema Claro / Escuro
            themeToggle.addEventListener('click', () => {
                document.documentElement.classList.toggle('dark');
            });
        })();
    </script>
</body>
</html>
